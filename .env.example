# Copy this file to .env and fill in what you need. Never commit .env.
#
# Everything here is optional. With no key at all, the synthetic demo and the
# tests work, and the dashboard starts normally.

# Your SerpApi key. Needed only for the Investigate tab and the experiment
# scripts. Each new request uses one credit; the dashboard states the maximum
# and asks before sending anything.
SERPAPI_API_KEY=

# Secret for reviewer/business pseudonyms in exports (at least 32 characters).
# Not needed by the dashboard. Set it yourself; the code never generates one.
REVIEWRING_PSEUDONYM_KEY=
